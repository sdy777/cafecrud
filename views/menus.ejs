
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>카페 메뉴 관리</title>
</head>
<body>
    <h1>카페 메뉴 관리</h1>

    <h2>메뉴 등록</h2>

    <form action="/menus/add" method="POST">
        메뉴명: <input type="text" name="name" required>
        <br><br>

        가격: <input type="number" name="price" required>
        <br><br>

        설명: <input type="text" name="description">
        <br><br>

        <button type="submit">등록</button>
    </form>

    <hr>

    <h2>메뉴 목록</h2>

    <table border="1">
        <tr>
            <th>번호</th>
            <th>메뉴명</th>
            <th>가격</th>
            <th>설명</th>
            <th>관리</th>
        </tr>

        <% menus.forEach(function(menu) { %>
        <tr>
            <td><%= menu.id %></td>
            <td><%= menu.name %></td>
            <td><%= menu.price %>원</td>
            <td><%= menu.description %></td>
            <td>
                <a href="/menus/edit/<%= menu.id %>">수정</a>

                <form action="/menus/delete/<%= menu.id %>" method="POST">
                    <button type="submit">삭제</button>
                </form>
            </td>
        </tr>
        <% }); %>
    </table>

</body>
</html>
