
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>메뉴 수정</title>
</head>
<body>
    <h1>카페 메뉴 수정</h1>

    <form action="/menus/update/<%= menu.id %>" method="POST">

        메뉴명:
        <input type="text" name="name" value="<%= menu.name %>" required>
        <br><br>

        가격:
        <input type="number" name="price" value="<%= menu.price %>" required>
        <br><br>

        설명:
        <input type="text" name="description" value="<%= menu.description || '' %>">
        <br><br>

        <button type="submit">수정 완료</button>
    </form>

    <br>

    <a href="/menus">목록으로 돌아가기</a>

</body>
</html>
